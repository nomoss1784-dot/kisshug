{
  "name": "kisshug",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:playables": "node scripts/art-manifest.mjs && node scripts/build-playables.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "art:manifest": "node scripts/art-manifest.mjs",
    "art:anchors": "node scripts/gen-anchors.mjs",
    "predev": "node scripts/art-manifest.mjs",
    "prebuild": "node scripts/art-manifest.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.6.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
